{
  "name": "@lucent/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor:bb": "node ../../scripts/vendor-bb.mjs",
    "predev": "pnpm --filter @lucent/sdk build && pnpm vendor:bb",
    "dev": "next dev --webpack",
    "prebuild": "pnpm --filter @lucent/sdk build && pnpm vendor:bb",
    "build": "next build --webpack",
    "build:cf": "pnpm --filter @lucent/sdk build && pnpm vendor:bb && opennextjs-cloudflare build",
    "preview": "pnpm run build:cf && wrangler dev",
    "deploy:cf": "pnpm run build:cf && opennextjs-cloudflare deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:ui": "node ../../scripts/ui-check.mjs"
  },
  "dependencies": {
    "@lucent/disclosure": "workspace:*",
    "@lucent/sdk": "workspace:*",
    "@opennextjs/cloudflare": "^1.19.11",
    "@stellar/freighter-api": "^4.1.0",
    "@stellar/stellar-sdk": "^14.2.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.0",
    "wrangler": "^4.100.0"
  }
}
