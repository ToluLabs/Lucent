# Analytics is off unless explicitly enabled. These values are public, NOT secrets.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Exact production hostname, no https://, port or path. Preview/local hosts are excluded.
NEXT_PUBLIC_ANALYTICS_HOSTNAME=www.lucent-pay.xyz
# Website ID from your Umami tracking snippet (not an API key).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Copy the script URL supplied by Umami. Change only for a trusted instance.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
