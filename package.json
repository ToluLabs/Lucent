{
  "name": "lucent",
  "version": "0.1.0",
  "private": true,
  "description": "Lucent \u2014 confidential payments on Stellar (Soroban): confidential token, payroll, escrow, auditor, and selective disclosure.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:sdk": "pnpm --filter @lucent/sdk build",
    "test:sdk": "pnpm --filter @lucent/sdk test",
    "dev": "pnpm --filter @lucent/app dev",
    "build:contracts": "bash scripts/build-contracts.sh",
    "build:disclosure": "pnpm --filter @lucent/sdk exec node ../../scripts/build-disclosure.mjs",
    "deploy:contracts": "pnpm --filter @lucent/sdk exec tsx ../../scripts/deploy.ts",
    "deploy:escrow": "pnpm --filter @lucent/sdk exec tsx ../../scripts/deploy-escrow.ts",
    "deploy:app": "pnpm --filter @lucent/app run deploy:cf",
    "e2e": "pnpm --filter @lucent/sdk exec tsx ../../scripts/e2e.ts",
    "e2e:disclosure": "pnpm --filter @lucent/sdk exec tsx ../../scripts/e2e-disclosure.ts",
    "e2e:escrow": "pnpm --filter @lucent/sdk exec tsx ../../scripts/e2e-escrow.ts",
    "test:analytics": "pnpm --filter @lucent/sdk exec tsx --tsconfig ../../packages/app/tsconfig.json ../../packages/app/test/analytics.mjs",
    "test:ui": "pnpm --filter @lucent/app test:ui",
    "test:forms": "pnpm --filter @lucent/app test:forms"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
